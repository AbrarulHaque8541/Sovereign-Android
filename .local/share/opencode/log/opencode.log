timestamp=2026-08-21T18:42:49.209Z level=INFO run=6fe02eea message=evaluated permission=bash pattern="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i /data/data/com.termux/files/home/.ssh/aws_key ubuntu@54.159.43.144 'python3 << \"PYEOF\"\nimport yaml, os\n\nconfig_path = os.path.expanduser(\"~/.hermes/config.yaml\")\nwith open(config_path, \"r\") as f:\n    config = yaml.safe_load(f) or {}\n\n# PRIMARY: Gemini (handles large context)\nconfig[\"model\"] = {\n    \"default\": \"gemini-3.6-flash\",\n    \"provider\": \"gemini\",\n    \"max_tokens\": 8192,\n}\n\n# ULTRA aggressive compression\nconfig[\"compression\"][\"enabled\"] = True\nconfig[\"compression\"][\"threshold\"] = 0.15  # Compress at 15% (VERY aggressive)\nconfig[\"compression\"][\"max_tokens\"] = 2048  # Keep only 2K after compression\nconfig[\"compression\"][\"strategy\"] = \"aggressive\"  # Drop old messages first\n\n# Agent\nconfig[\"agent\"][\"reasoning_effort\"] = \"none\"\nconfig[\"agent\"][\"max_turns\"] = 50  # More turns allowed\nconfig[\"agent\"][\"max_iterations\"] = 50\n\n# Fallback: speed after compression\nconfig[\"fallback_model\"] = [\n    # After compression, context is small → Groq works\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"qwen/qwen3.6-27b\", \"provider\": \"groq\"},\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"openai/gpt-oss-20b\", \"provider\": \"groq\"},\n    # If Groq rate limited, back to Gemini\n    {\"base_url\": \"https://generativelanguage.googleapis.com/v1beta\", \"model\": \"gemini-3.6-flash\", \"provider\": \"gemini\"},\n    # Others\n    {\"base_url\": \"https://api.mistral.ai/v1\", \"model\": \"mistral-small-latest\", \"provider\": \"mistral\"},\n    {\"base_url\": \"https://api.upstage.ai/v1/solar\", \"model\": \"solar-pro\", \"provider\": \"upstage\"},\n    {\"base_url\": \"https://api.inference.wandb.ai/v1\", \"model\": \"meta-llama/Llama-3.1-8B-Instruct\", \"provider\": \"wandb\"},\n    {\"base_url\": \"https://gen.pollinations.ai/v1\", \"model\": \"openai\", \"provider\": \"pollinations\"},\n]\n\nwith open(config_path, \"w\") as f:\n    yaml.dump(config, f, default_flow_style=False, allow_unicode=True)\nprint(\"ULTRA aggressive compression enabled\")\nprint(\"Threshold: 15%, Max tokens: 2048, Strategy: aggressive\")\nPYEOF'" action.permission=* action.action=allow action.pattern=*
