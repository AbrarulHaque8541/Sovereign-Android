timestamp=2026-08-21T17:31:18.456Z level=INFO run=6fe02eea message=evaluated permission=bash pattern="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i /data/data/com.termux/files/home/.ssh/aws_key ubuntu@54.159.43.144 'python3 << \"PYEOF\"\nimport yaml, os\n\nconfig_path = os.path.expanduser(\"~/.hermes/config.yaml\")\nwith open(config_path, \"r\") as f:\n    config = yaml.safe_load(f) or {}\n\n# PRIMARY: Ollama Cloud 120B (128K context, no TPM limit)\nconfig[\"model\"] = {\n    \"default\": \"gpt-oss:120b\",\n    \"provider\": \"ollama_cloud\",\n    \"max_tokens\": 8192\n}\n\n# Agent settings\nconfig[\"agent\"][\"reasoning_effort\"] = \"none\"\nconfig[\"agent\"][\"max_turns\"] = 20\n\n# Compression - smart: only compress when really needed\nconfig[\"compression\"][\"enabled\"] = True\nconfig[\"compression\"][\"threshold\"] = 0.8\n\n# Timeout - generous for large contexts\nconfig[\"terminal\"][\"timeout\"] = 120\n\n# Fallback chain - SPEED + POWER order\nconfig[\"fallback_model\"] = [\n    # Fast + Large context (primary tier)\n    {\"base_url\": \"https://ollama.com\", \"model\": \"gpt-oss:120b\", \"provider\": \"ollama_cloud\"},\n    {\"base_url\": \"https://integrate.api.nvidia.com/v1\", \"model\": \"openai/gpt-oss-120b\", \"provider\": \"nvidia\"},\n    # Fast + Small context (for simple queries)\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"openai/gpt-oss-120b\", \"provider\": \"groq\"},\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"qwen/qwen3.6-27b\", \"provider\": \"groq\"},\n    # Medium tier\n    {\"base_url\": \"https://api.mistral.ai/v1\", \"model\": \"mistral-small-latest\", \"provider\": \"mistral\"},\n    {\"base_url\": \"https://api.upstage.ai/v1/solar\", \"model\": \"solar-pro\", \"provider\": \"upstage\"},\n    {\"base_url\": \"https://api.inference.wandb.ai/v1\", \"model\": \"meta-llama/Llama-3.1-8B-Instruct\", \"provider\": \"wandb\"},\n    # Large context fallbacks\n    {\"base_url\": \"https://generativelanguage.googleapis.com/v1beta\", \"model\": \"gemini-3.6-flash\", \"provider\": \"gemini\"},\n    {\"base_url\": \"https://gen.pollinations.ai/v1\", \"model\": \"openai\", \"provider\": \"pollinations\"},\n]\n\nwith open(config_path, \"w\") as f:\n    yaml.dump(config, f, default_flow_style=False, allow_unicode=True)\n\nprint(\"PRIMARY: Ollama Cloud gpt-oss:120b (128K context)\")\nprint(\"FALLBACK: 9 providers (Nvidia, Groq, Mistral, Upstage, Wandb, Gemini, Pollinations)\")\nprint(\"POWER: FULL - no reduction!\")\nPYEOF'" action.permission=* action.action=allow action.pattern=*
