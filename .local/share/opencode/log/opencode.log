timestamp=2026-08-21T17:11:40.376Z level=INFO run=6fe02eea message=evaluated permission=bash pattern="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i /data/data/com.termux/files/home/.ssh/aws_key ubuntu@54.159.43.144 'python3 << \"PYEOF\"\nimport yaml, os\n\nconfig_path = os.path.expanduser(\"~/.hermes/config.yaml\")\nwith open(config_path, \"r\") as f:\n    config = yaml.safe_load(f) or {}\n\n# Primary: Groq (fastest)\nconfig[\"model\"] = {\n    \"default\": \"qwen/qwen3.6-27b\",\n    \"provider\": \"groq\",\n    \"max_tokens\": 4096\n}\n\n# Reasoning\nconfig[\"agent\"][\"reasoning_effort\"] = \"none\"\nconfig[\"agent\"][\"max_turns\"] = 15\n\n# Compression ON\nconfig[\"compression\"][\"enabled\"] = True\nconfig[\"compression\"][\"threshold\"] = 0.3\n\n# Timeout\nconfig[\"terminal\"][\"timeout\"] = 60\n\n# Providers\nconfig[\"providers\"] = {\n    \"groq\": {\"base_url\": \"https://api.groq.com/openai/v1\", \"key_env\": \"GROQ_API_KEY\"},\n    \"nvidia\": {\"base_url\": \"https://integrate.api.nvidia.com/v1\", \"key_env\": \"NVIDIA_API_KEY\"},\n    \"gemini\": {\"base_url\": \"https://generativelanguage.googleapis.com/v1beta\", \"key_env\": \"GEMINI_API_KEY\"},\n    \"mistral\": {\"base_url\": \"https://api.mistral.ai/v1\", \"key_env\": \"MISTRAL_API_KEY\"},\n    \"upstage\": {\"base_url\": \"https://api.upstage.ai/v1/solar\", \"key_env\": \"UPSTAGE_API_KEY\"},\n    \"wandb\": {\"base_url\": \"https://api.inference.wandb.ai/v1\", \"key_env\": \"WANDB_API_KEY\"},\n    \"ollama_cloud\": {\"base_url\": \"https://ollama.com\", \"key_env\": \"OLLAMA_API_KEY\"},\n    \"pollinations\": {\"base_url\": \"https://gen.pollinations.ai/v1\", \"key_env\": \"POLLINATIONS_API_KEY\"},\n    \"ollama\": {\"base_url\": \"http://localhost:11434/v1\"},\n}\n\n# Fallback chain - speed order\nconfig[\"fallback_model\"] = [\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"qwen/qwen3.6-27b\", \"provider\": \"groq\"},\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"openai/gpt-oss-20b\", \"provider\": \"groq\"},\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"openai/gpt-oss-120b\", \"provider\": \"groq\"},\n    {\"base_url\": \"https://ollama.com\", \"model\": \"gpt-oss:120b\", \"provider\": \"ollama_cloud\"},\n    {\"base_url\": \"https://integrate.api.nvidia.com/v1\", \"model\": \"openai/gpt-oss-20b\", \"provider\": \"nvidia\"},\n    {\"base_url\": \"https://integrate.api.nvidia.com/v1\", \"model\": \"nvidia/nemotron-3-ultra-550b-a55b\", \"provider\": \"nvidia\"},\n    {\"base_url\": \"https://api.mistral.ai/v1\", \"model\": \"mistral-small-latest\", \"provider\": \"mistral\"},\n    {\"base_url\": \"https://api.upstage.ai/v1/solar\", \"model\": \"solar-pro\", \"provider\": \"upstage\"},\n    {\"base_url\": \"https://api.inference.wandb.ai/v1\", \"model\": \"meta-llama/Llama-3.1-8B-Instruct\", \"provider\": \"wandb\"},\n    {\"base_url\": \"https://gen.pollinations.ai/v1\", \"model\": \"openai\", \"provider\": \"pollinations\"},\n]\n\nwith open(config_path, \"w\") as f:\n    yaml.dump(config, f, default_flow_style=False, allow_unicode=True)\n\nprint(\"Config: 10 fallback providers, Groq primary, compression ON\")\nPYEOF'" action.permission=* action.action=allow action.pattern=*
