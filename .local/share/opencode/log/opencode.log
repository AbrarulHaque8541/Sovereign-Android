timestamp=2026-08-21T17:59:28.189Z level=INFO run=6fe02eea message=evaluated permission=bash pattern="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i /data/data/com.termux/files/home/.ssh/aws_key ubuntu@54.159.43.144 'python3 << \"PYEOF\"\nimport yaml, os\n\nconfig_path = os.path.expanduser(\"~/.hermes/config.yaml\")\nwith open(config_path, \"r\") as f:\n    config = yaml.safe_load(f) or {}\n\n# ========== MODEL ==========\nconfig[\"model\"] = {\n    \"default\": \"gpt-oss:120b\",\n    \"provider\": \"ollama_cloud\",\n    \"max_tokens\": 8192,\n    \"supports_vision\": True,\n}\n\n# ========== AGENT ==========\nconfig[\"agent\"] = config.get(\"agent\", {})\nconfig[\"agent\"][\"reasoning_effort\"] = \"none\"\nconfig[\"agent\"][\"max_turns\"] = 30\nconfig[\"agent\"][\"max_iterations\"] = 50\n\n# ========== IMAGE PROCESSING ==========\nconfig[\"agent\"][\"image_input_mode\"] = \"auto\"  # auto-detect vision support\n\n# ========== STT (Speech-to-Text) ==========\nconfig[\"stt\"] = {\n    \"enabled\": True,\n    \"provider\": \"groq\",  # Groq Whisper - fast + free\n    \"echo_transcripts\": True,\n}\n\n# ========== VOICE ==========\nconfig[\"voice\"] = {\n    \"enabled\": True,\n    \"auto_tts\": False,\n}\n\n# ========== COMPRESSION ==========\nconfig[\"compression\"] = {\n    \"enabled\": True,\n    \"threshold\": 0.8,\n}\n\n# ========== TIMEOUT ==========\nconfig[\"terminal\"] = config.get(\"terminal\", {})\nconfig[\"terminal\"][\"timeout\"] = 120\n\n# ========== CONCURRENT MESSAGES ==========\nconfig[\"gateway\"] = config.get(\"gateway\", {})\nconfig[\"gateway\"][\"max_concurrent_requests\"] = 10\nconfig[\"gateway\"][\"message_queue_size\"] = 100\n\n# ========== PROVIDERS ==========\nconfig[\"providers\"] = {\n    \"groq\": {\"base_url\": \"https://api.groq.com/openai/v1\", \"key_env\": \"GROQ_API_KEY\"},\n    \"nvidia\": {\"base_url\": \"https://integrate.api.nvidia.com/v1\", \"key_env\": \"NVIDIA_API_KEY\"},\n    \"gemini\": {\"base_url\": \"https://generativelanguage.googleapis.com/v1beta\", \"key_env\": \"GEMINI_API_KEY\"},\n    \"mistral\": {\"base_url\": \"https://api.mistral.ai/v1\", \"key_env\": \"MISTRAL_API_KEY\"},\n    \"upstage\": {\"base_url\": \"https://api.upstage.ai/v1/solar\", \"key_env\": \"UPSTAGE_API_KEY\"},\n    \"wandb\": {\"base_url\": \"https://api.inference.wandb.ai/v1\", \"key_env\": \"WANDB_API_KEY\"},\n    \"ollama_cloud\": {\"base_url\": \"https://ollama.com\", \"key_env\": \"OLLAMA_API_KEY\"},\n    \"pollinations\": {\"base_url\": \"https://gen.pollinations.ai/v1\", \"key_env\": \"POLLINATIONS_API_KEY\"},\n    \"ollama\": {\"base_url\": \"http://localhost:11434/v1\"},\n}\n\n# ========== FALLBACK CHAIN ==========\nconfig[\"fallback_model\"] = [\n    # Tier 1: Large context + fast\n    {\"base_url\": \"https://ollama.com\", \"model\": \"gpt-oss:120b\", \"provider\": \"ollama_cloud\"},\n    {\"base_url\": \"https://integrate.api.nvidia.com/v1\", \"model\": \"openai/gpt-oss-120b\", \"provider\": \"nvidia\"},\n    # Tier 2: Fast + vision\n    {\"base_url\": \"https://generativelanguage.googleapis.com/v1beta\", \"model\": \"gemini-3.6-flash\", \"provider\": \"gemini\"},\n    # Tier 3: Fast + small\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"openai/gpt-oss-120b\", \"provider\": \"groq\"},\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"qwen/qwen3.6-27b\", \"provider\": \"groq\"},\n    # Tier 4: Medium\n    {\"base_url\": \"https://api.mistral.ai/v1\", \"model\": \"mistral-small-latest\", \"provider\": \"mistral\"},\n    {\"base_url\": \"https://api.upstage.ai/v1/solar\", \"model\": \"solar-pro\", \"provider\": \"upstage\"},\n    {\"base_url\": \"https://api.inference.wandb.ai/v1\", \"model\": \"meta-llama/Llama-3.1-8B-Instruct\", \"provider\": \"wandb\"},\n    {\"base_url\": \"https://gen.pollinations.ai/v1\", \"model\": \"openai\", \"provider\": \"pollinations\"},\n]\n\nwith open(config_path, \"w\") as f:\n    yaml.dump(config, f, default_flow_style=False, allow_unicode=True)\n\nprint(\"=== FULL POWER CONFIG APPLIED ===\")\nprint(\"1. Vision: ENABLED (auto-detect)\")\nprint(\"2. STT: ENABLED (Groq Whisper)\")\nprint(\"3. Voice: ENABLED\")\nprint(\"4. Concurrent: 10 requests\")\nprint(\"5. Max turns: 30\")\nprint(\"6. Max iterations: 50\")\nprint(\"7. Compression: 80% threshold\")\nprint(\"8. Timeout: 120s\")\nprint(\"9. 9 fallback providers\")\nprint(\"10. Full capability - NO reduction\")\nPYEOF'" action.permission=* action.action=allow action.pattern=*
