timestamp=2026-08-22T07:44:27.716Z level=INFO run=688fafd5 message=evaluated permission=bash pattern="cat << 'TERMUX_SCRIPT' > /tmp/complete_isolation.sh\n#!/system/bin/sh\n# ============================================================\n# COMPLETE NETWORK ISOLATION FOR com.itoeaoe.rmk\n# Run this from Termux NATIVE shell (NOT proot)\n# ============================================================\n\necho \"==========================================\"\necho \"  COMPLETE NETWORK ISOLATION SETUP\"\necho \"==========================================\"\n\n# Step 1: Get the app's UID\necho \"\"\necho \"[1/6] Getting app UID...\"\nAPP_UID=$(pm list packages -U com.itoeaoe.rmk 2>/dev/null | grep -oP 'uid:\\K[0-9]+')\nif [ -z \"$APP_UID\" ]; then\n    echo \"ERROR: App not found. Installing...\"\n    pm install /sdcard/Download/f2UArtbz6.apk\n    APP_UID=$(pm list packages -U com.itoeaoe.rmk 2>/dev/null | grep -oP 'uid:\\K[0-9]+')\nfi\necho \"App UID: $APP_UID\"\n\n# Step 2: Kill the app if running\necho \"\"\necho \"[2/6] Stopping app...\"\nam force-stop com.itoeaoe.rmk\nsleep 2\n\n# Step 3: Apply STRICT network restrictions\necho \"\"\necho \"[3/6] Applying strict network restrictions...\"\n\n# Block ALL TCP ports\niptables -A OUTPUT -p tcp -m owner --uid-owner $APP_UID -j DROP\necho \"  [OK] Blocked all TCP traffic\"\n\n# Block ALL UDP ports  \niptables -A OUTPUT -p udp -m owner --uid-owner $APP_UID -j DROP\necho \"  [OK] Blocked all UDP traffic\"\n\n# Block ICMP\niptables -A OUTPUT -p icmp -m owner --uid-owner $APP_UID -j DROP\necho \"  [OK] Blocked ICMP (ping)\"\n\n# Block IPv6\nip6tables -A OUTPUT -p tcp -m owner --uid-owner $APP_UID -j DROP\nip6tables -A OUTPUT -p udp -m owner --uid-owner $APP_UID -j DROP\nip6tables -A OUTPUT -p icmpv6 -m owner --uid-owner $APP_UID -j DROP\necho \"  [OK] Blocked IPv6 traffic\"\n\n# ALLOW loopback (needed for app to function)\niptables -I OUTPUT 1 -d 127.0.0.0/8 -m owner --uid-owner $APP_UID -j ACCEPT\niptables -I INPUT 1 -s 127.0.0.0/8 -m owner --uid-owner $APP_UID -j ACCEPT\necho \"  [OK] Allowed loopback (for UI)\"\n\n# Step 4: Force restrict background data\necho \"\"\necho \"[4/6] Restricting background data...\"\ncmd netpolicy add restrict-background true 2>/dev/null\ncmd netpolicy set restrict-background $APP_UID true 2>/dev/null\necho \"  [OK] Background data restricted\"\n\n# Step 5: Grant necessary permissions\necho \"\"\necho \"[5/6] Granting permissions...\"\npm grant com.itoeaoe.rmk android.permission.CAMERA 2>/dev/null\npm grant com.itoeaoe.rmk android.permission.READ_EXTERNAL_STORAGE 2>/dev/null\npm grant com.itoeaoe.rmk android.permission.WRITE_EXTERNAL_STORAGE 2>/dev/null\npm grant com.itoeaoe.rmk android.permission.RECORD_AUDIO 2>/dev/null\npm grant com.itoeaoe.rmk android.permission.ACCESS_FINE_LOCATION 2>/dev/null\npm grant com.itoeaoe.rmk android.permission.ACCESS_COARSE_LOCATION 2>/dev/null\necho \"  [OK] Permissions granted\"\n\n# Step 6: Launch the app\necho \"\"\necho \"[6/6] Launching app...\"\nam start -n com.itoeaoe.rmk/com.shell.a.MainActivity\n\necho \"\"\necho \"==========================================\"\necho \"  ISOLATION ACTIVE!\"\necho \"==========================================\"\necho \"\"\necho \"What's BLOCKED:\"\necho \"  - ALL internet traffic (TCP/UDP/ICMP)\"\necho \"  - ALL DNS queries\"\necho \"  - ALL IPv6 traffic\"\necho \"  - Background data\"\necho \"\"\necho \"What's ALLOWED:\"\necho \"  - Camera permission\"\necho \"  - Storage/Gallery permission\"\necho \"  - Microphone permission\"\necho \"  - Location permission\"\necho \"  - UI interactions\"\necho \"  - Local loopback\"\necho \"\"\necho \"The app can use Camera/Gallery but CANNOT send data anywhere.\"\necho \"\"\necho \"To verify rules: iptables -L OUTPUT -n | grep $APP_UID\"\necho \"To remove rules: sh /tmp/complete_isolation.sh unblock\"\necho \"==========================================\"\n\n# Handle unblock command\nif [ \"$1\" = \"unblock\" ]; then\n    echo \"\"\n    echo \"Removing all blocking rules...\"\n    while iptables -D OUTPUT -p tcp -m owner --uid-owner $APP_UID -j DROP 2>/dev/null; do :; done\n    while iptables -D OUTPUT -p udp -m owner --uid-owner $APP_UID -j DROP 2>/dev/null; do :; done\n    while iptables -D OUTPUT -p icmp -m owner --uid-owner $APP_UID -j DROP 2>/dev/null; do :; done\n    while ip6tables -D OUTPUT -p tcp -m owner --uid-owner $APP_UID -j DROP 2>/dev/null; do :; done\n    while ip6tables -D OUTPUT -p udp -m owner --uid-owner $APP_UID -j DROP 2>/dev/null; do :; done\n    while ip6tables -D OUTPUT -p icmpv6 -m owner --uid-owner $APP_UID -j DROP 2>/dev/null; do :; done\n    while iptables -D OUTPUT -d 127.0.0.0/8 -m owner --uid-owner $APP_UID -j ACCEPT 2>/dev/null; do :; done\n    while iptables -D INPUT -s 127.0.0.0/8 -m owner --uid-owner $APP_UID -j ACCEPT 2>/dev/null; do :; done\n    echo \"All rules removed!\"\nfi\nTERMUX_SCRIPT" action.permission=* action.action=allow action.pattern=*
