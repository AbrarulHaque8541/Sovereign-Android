timestamp=2026-08-22T07:46:41.864Z level=INFO run=688fafd5 message=evaluated permission=bash pattern="python3 << 'PYTHON_DEX'\nimport re\n\n# Read the extracted DEX\nwith open('/tmp/classes_extracted.dex', 'rb') as f:\n    data = f.read()\n\n# Find all readable strings\nstrings = set()\nfor match in re.finditer(rb'[\\x20-\\x7e]{8,}', data):\n    s = match.group().decode('ascii', errors='ignore')\n    strings.add(s)\n\n# Look for URLs, domains, IPs, and network patterns\nnetwork_patterns = []\nfor s in strings:\n    # Check for URLs\n    if 'http' in s.lower() or 'https' in s.lower():\n        network_patterns.append(('URL', s))\n    # Check for domains\n    elif re.search(r'[a-z0-9]+\\.(com|net|org|io|co)', s.lower()):\n        network_patterns.append(('DOMAIN', s))\n    # Check for IPs\n    elif re.search(r'\\d+\\.\\d+\\.\\d+\\.\\d+', s):\n        network_patterns.append(('IP', s))\n    # Check for socket/connect patterns\n    elif any(x in s.lower() for x in ['socket', 'connect', 'server', 'vpn', 'proxy']):\n        network_patterns.append(('NETWORK', s))\n\nprint(f\"Total readable strings: {len(strings)}\")\nprint(f\"Network-related patterns: {len(network_patterns)}\")\n\n# Print network patterns\nfor ptype, p in sorted(set(network_patterns)):\n    print(f\"  [{ptype}] {p[:120]}\")\nPYTHON_DEX" action.permission=* action.action=allow action.pattern=*
