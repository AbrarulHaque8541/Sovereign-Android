timestamp=2026-08-21T18:12:25.534Z level=INFO run=6fe02eea message=evaluated permission=bash pattern="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i /data/data/com.termux/files/home/.ssh/aws_key ubuntu@54.159.43.144 'pkill -9 -f \"hermes_cli.main\" 2>/dev/null; sleep 2\n\n# 1. Clean ALL session data\npython3 << \"PYEOF\"\nimport sqlite3, json, os\n\ndb = os.path.expanduser(\"~/.hermes/state.db\")\nconn = sqlite3.connect(db)\nc = conn.cursor()\nc.execute(\"DELETE FROM messages\")\nc.execute(\"DELETE FROM gateway_routing\")\nc.execute(\"DELETE FROM sessions\")\nconn.commit()\nconn.close()\nprint(\"Database cleared\")\n\n# Clear sessions.json\npath = os.path.expanduser(\"~/.hermes/sessions/sessions.json\")\nwith open(path, \"w\") as f:\n    json.dump({}, f)\nprint(\"sessions.json cleared\")\n\n# Clear any session files\nimport glob\nfor f in glob.glob(os.path.expanduser(\"~/.hermes/sessions/*.jsonl\")):\n    os.remove(f)\n    print(\"Deleted:\", f)\nPYEOF\n\n# 2. Update config - Groq 20B primary (FASTEST), Gemini fallback\npython3 << \"PYEOF\"\nimport yaml, os\n\nconfig_path = os.path.expanduser(\"~/.hermes/config.yaml\")\nwith open(config_path, \"r\") as f:\n    config = yaml.safe_load(f) or {}\n\n# PRIMARY: Groq 20B (fastest, ~0.5s)\nconfig[\"model\"] = {\n    \"default\": \"openai/gpt-oss-20b\",\n    \"provider\": \"groq\",\n    \"max_tokens\": 4096,\n    \"supports_vision\": False,\n}\n\nconfig[\"agent\"][\"reasoning_effort\"] = \"none\"\nconfig[\"agent\"][\"max_turns\"] = 30\n\n# Compression ON\nconfig[\"compression\"][\"enabled\"] = True\nconfig[\"compression\"][\"threshold\"] = 0.7\n\n# Fallback: speed first, then power\nconfig[\"fallback_model\"] = [\n    # Tier 1: FASTEST (< 2s)\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"qwen/qwen3.6-27b\", \"provider\": \"groq\"},\n    {\"base_url\": \"https://api.groq.com/openai/v1\", \"model\": \"openai/gpt-oss-120b\", \"provider\": \"groq\"},\n    # Tier 2: FAST + LARGE CONTEXT\n    {\"base_url\": \"https://generativelanguage.googleapis.com/v1beta\", \"model\": \"gemini-3.6-flash\", \"provider\": \"gemini\"},\n    # Tier 3: MEDIUM\n    {\"base_url\": \"https://api.mistral.ai/v1\", \"model\": \"mistral-small-latest\", \"provider\": \"mistral\"},\n    {\"base_url\": \"https://api.upstage.ai/v1/solar\", \"model\": \"solar-pro\", \"provider\": \"upstage\"},\n    {\"base_url\": \"https://api.inference.wandb.ai/v1\", \"model\": \"meta-llama/Llama-3.1-8B-Instruct\", \"provider\": \"wandb\"},\n    {\"base_url\": \"https://gen.pollinations.ai/v1\", \"model\": \"openai\", \"provider\": \"pollinations\"},\n]\n\nwith open(config_path, \"w\") as f:\n    yaml.dump(config, f, default_flow_style=False, allow_unicode=True)\nprint(\"Config: Groq 20B primary, 7 fallbacks\")\nPYEOF\n\n# 3. Restart fresh\nrm -f ~/.hermes/gateway.pid ~/.hermes/gateway.lock\ncd ~/.hermes && nohup hermes gateway > /tmp/gw7.log 2>&1 &\nsleep 20\ncat ~/.hermes/gateway_state.json | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get(\\\"pid\\\"), d.get(\\\"gateway_state\\\"))\"\ntail -3 ~/.hermes/logs/gateway.log | grep -E \"running|connected\"'" action.permission=* action.action=allow action.pattern=*
