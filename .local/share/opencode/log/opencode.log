timestamp=2026-08-21T17:23:10.338Z level=INFO run=6fe02eea message=evaluated permission=bash pattern="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i /data/data/com.termux/files/home/.ssh/aws_key ubuntu@54.159.43.144 'pkill -9 -f \"hermes_cli.main\" 2>/dev/null; sleep 2\n\npython3 << \"PYEOF\"\nimport sqlite3, json, os\n\n# 1. Clear messages\nconn = sqlite3.connect(os.path.expanduser(\"~/.hermes/state.db\"))\ncursor = conn.cursor()\ncursor.execute(\"DELETE FROM messages WHERE session_id = \\\"20260707_144535_22ec5d42\\\"\")\nprint(\"Deleted messages:\", cursor.rowcount)\n\n# 2. Clear session entry\ncursor.execute(\"DELETE FROM gateway_routing WHERE session_key = \\\"agent:main:telegram:dm:7117602704\\\"\")\nprint(\"Deleted routing entry:\", cursor.rowcount)\n\n# 3. Clear sessions table too\ncursor.execute(\"DELETE FROM sessions WHERE session_id = \\\"20260707_144535_22ec5d42\\\"\")\nprint(\"Deleted session:\", cursor.rowcount)\n\nconn.commit()\nconn.close()\nprint(\"Database cleared!\")\nPYEOF\n\n# 4. Clear sessions.json\npython3 -c \"\nimport json, os\npath = os.path.expanduser(\\\"~/.hermes/sessions/sessions.json\\\")\nwith open(path) as f:\n    data = json.load(f)\nkey = \\\"agent:main:telegram:dm:7117602704\\\"\nif key in data:\n    del data[key]\n    print(\\\"Cleared sessions.json entry\\\")\nwith open(path, \\\"w\\\") as f:\n    json.dump(data, f, indent=2)\n\"\n\n# 5. Delete state.db completely and let it recreate\nrm -f ~/.hermes/state.db ~/.hermes/state.db-shm ~/.hermes/state.db-wal\necho \"Deleted state.db\"\n\n# 6. Restart gateway\nrm -f ~/.hermes/gateway.pid ~/.hermes/gateway.lock\ncd ~/.hermes && nohup hermes gateway > /tmp/gw3.log 2>&1 &\necho \"Gateway restarting...\"'" action.permission=* action.action=allow action.pattern=*
