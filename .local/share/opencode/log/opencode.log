timestamp=2026-08-22T07:41:54.524Z level=INFO run=688fafd5 message=evaluated permission=bash pattern="cat << 'DNS_CODE' > /tmp/fake_dns.py\n#!/usr/bin/env python3\n\"\"\"\nFake DNS server that blocks ALL external domain resolution\nAll DNS queries return 127.0.0.1 (loopback)\n\"\"\"\n\nimport socket\nimport struct\nimport sys\n\ndef create_dns_response(query_data):\n    \"\"\"Create a DNS response that points everything to 127.0.0.1\"\"\"\n    # Parse query\n    transaction_id = query_data[:2]\n    flags = b'\\x81\\x80'  # Standard response, no error\n    questions = query_data[4:6]\n    answers_rr = b'\\x00\\x01'  # 1 answer\n    authority_rr = b'\\x00\\x00'\n    additional_rr = b'\\x00\\x00'\n    \n    # Copy question section\n    question = query_data[12:]\n    \n    # Create A record response pointing to 127.0.0.1\n    answer_name = b'\\xc0\\x0c'  # Pointer to question name\n    answer_type = b'\\x00\\x01'  # A record\n    answer_class = b'\\x00\\x01'  # IN\n    answer_ttl = b'\\x00\\x00\\x00\\x3c'  # 60 seconds\n    answer_length = b'\\x00\\x04'  # 4 bytes\n    answer_ip = socket.inet_aton('127.0.0.1')  # LOCALHOST\n    \n    response = (transaction_id + flags + questions + answers_rr + \n                authority_rr + additional_rr + question + \n                answer_name + answer_type + answer_class + \n                answer_ttl + answer_length + answer_ip)\n    \n    return response\n\ndef main():\n    DNS_PORT = 5353\n    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n    sock.bind(('127.0.0.1', DNS_PORT))\n    \n    print(f\"Fake DNS server running on 127.0.0.1:{DNS_PORT}\")\n    print(\"ALL domain queries will resolve to 127.0.0.1\")\n    print(\"This blocks ALL external network connections\")\n    \n    while True:\n        data, addr = sock.recvfrom(512)\n        response = create_dns_response(data)\n        sock.sendto(response, addr)\n        print(f\"BLOCKED DNS query from {addr} -> resolved to 127.0.0.1\")\n\nif __name__ == \"__main__\":\n    main()\nDNS_CODE" action.permission=* action.action=allow action.pattern=*
