timestamp=2026-08-22T06:38:00.745Z level=INFO run=0e3fc1ba message=evaluated permission=bash pattern="cat << 'TERMINAL_INSTRUCTIONS'\n==============================================\nCOPY THIS ENTIRE BLOCK AND PASTE IN TERMUX\n(Run outside proot - in native Termux shell)\n==============================================\n\n# Get the app UID\nAPP_UID=$(pm list packages -U com.itoeaoe.rmk 2>/dev/null | grep -oP 'uid:\\K[0-9]+')\necho \"App UID: $APP_UID\"\n\n# BLOCK internet traffic (allow Camera/Storage/permissions)\n# TCP web ports\nfor PORT in 80 443 8080 8443 8000 8888 5222 5228; do\n    iptables -A OUTPUT -p tcp --dport $PORT -m owner --uid-owner $APP_UID -j DROP\ndone\n\n# DNS\niptables -A OUTPUT -p udp --dport 53 -m owner --uid-owner $APP_UID -j DROP\niptables -A OUTPUT -p tcp --dport 53 -m owner --uid-owner $APP_UID -j DROP\n\n# ICMP\niptables -A OUTPUT -p icmp -m owner --uid-owner $APP_UID -j DROP\n\n# IPv6\nfor PORT in 80 443 8080 8443 53; do\n    ip6tables -A OUTPUT -p tcp --dport $PORT -m owner --uid-owner $APP_UID -j DROP\n    ip6tables -A OUTPUT -p udp --dport $PORT -m owner --uid-owner $APP_UID -j DROP\ndone\n\n# ALLOW loopback and local (for Camera/Storage permissions)\niptables -A OUTPUT -d 127.0.0.0/8 -m owner --uid-owner $APP_UID -j ACCEPT\niptables -A OUTPUT -d 10.0.0.0/8 -m owner --uid-owner $APP_UID -j ACCEPT\niptables -A OUTPUT -d 172.16.0.0/12 -m owner --uid-owner $APP_UID -j ACCEPT\niptables -A OUTPUT -d 192.168.0.0/16 -m owner --uid-owner $APP_UID -j ACCEPT\n\necho \"Network isolation applied! Safe to launch app.\"\n\n# LAUNCH THE APP\nam start -n com.itoeaoe.rmk/com.shell.a.MainActivity\n\n==============================================\nTERMINAL_INSTRUCTIONS" action.permission=* action.action=allow action.pattern=*
