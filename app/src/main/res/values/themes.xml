<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Sovereign" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorPrimaryVariant">@color/primary_purple_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary_teal</item>
        <item name="colorSecondaryVariant">@color/secondary_teal_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <!-- Error color -->
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/on_error</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="colorSurface">@color/surface_primary</item>
        
        <!-- Text colors -->
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        
        <!-- Status bar and navigation -->
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    
    <!-- Card theme -->
    <style name="Widget.Sovereign.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_primary</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <!-- Button themes -->
    <style name="Widget.Sovereign.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_purple</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
    
    <style name="Widget.Sovereign.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_purple</item>
        <item name="android:textColor">@color/primary_purple</item>
    </style>
    
    <style name="Widget.Sovereign.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/error_red</item>
        <item name="android:textColor">@color/on_error</item>
    </style>
    
    <!-- Chip theme -->
    <style name="Widget.Sovereign.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/surface_secondary</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="chipStrokeColor">@color/outline_variant</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>
    
    <!-- Text input theme -->
    <style name="Widget.Sovereign.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/background_secondary</item>
        <item name="boxStrokeColor">@color/outline_variant</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/on_surface</item>
    </style>
    
    <!-- Toolbar theme -->
    <style name="Theme.Sovereign.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorOnPrimary">@color/on_primary</item>
    </style>
    
    <!-- Dialog theme -->
    <style name="Theme.Sovereign.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>
    
    <!-- Bottom sheet theme -->
    <style name="Theme.Sovereign.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>
</resources>